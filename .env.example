# LMS Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider API Keys (add the ones you want to use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default provider (anthropic, openai, or google)
LMS_DEFAULT_PROVIDER=anthropic

# Default model per provider (optional)
LMS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
LMS_OPENAI_MODEL=gpt-4o
LMS_GOOGLE_MODEL=gemini-1.5-pro

# Local OpenAI-compatible endpoint (vLLM, SGLang, Ollama). Leave commented out
# for the hosted OpenAI API. The path must include the API version segment —
# http://localhost:8000 without /v1 yields 404s that look like server errors.
# When set, OPENAI_API_KEY may be any non-empty placeholder; local servers do
# not check it.
#   LMS_OPENAI_BASE_URL=http://localhost:8000/v1
#   LMS_OPENAI_MODEL=Qwen/Qwen3-Coder-30B-A3B
#   OPENAI_API_KEY=local
